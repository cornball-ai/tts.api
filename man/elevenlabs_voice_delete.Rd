\name{elevenlabs_voice_delete}
\alias{elevenlabs_voice_delete}
\title{Delete ElevenLabs Voice}
\description{Delete a voice from your ElevenLabs account.}
\usage{
elevenlabs_voice_delete(voice_id)
}
\arguments{
  \item{voice_id}{Character. The voice ID to delete.}
}
\value{
Invisible TRUE on success.
}
\examples{
\dontrun{
elevenlabs_voice_delete("abc123")
}
}
