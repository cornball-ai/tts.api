\name{set_elevenlabs_key}
\alias{set_elevenlabs_key}
\title{Set ElevenLabs API Key}
\description{Configure the API key for ElevenLabs TTS backend.}
\usage{
set_elevenlabs_key(api_key)
}
\arguments{
  \item{api_key}{Character. Your ElevenLabs API key.}
}
\examples{
\dontrun{
set_elevenlabs_key("your-api-key-here")
# Or use environment variable ELEVENLABS_API_KEY
}
}
